# 复制为 .env 后按需覆盖；不填也能跑（tfidf + lexical 后端）

# dense 后端: bge-m3 | tfidf
RAGMINI_EMBEDDER=bge-m3
# 模型名或本地路径（离线时可指向已下载目录）
RAGMINI_EMBED_MODEL=BAAI/bge-m3

# rerank 后端: cross-encoder | lexical | off
RAGMINI_RERANKER=cross-encoder
RAGMINI_RERANK_MODEL=BAAI/bge-reranker-large

# 拒答阈值（dense 余弦）
RAGMINI_ANSWER_THRESHOLD=0.35

# 可选：配置后生成走 LLM，否则返回命中条款原文
# RAGMINI_API_KEY=sk-xxx
# RAGMINI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RAGMINI_MODEL=qwen-plus
